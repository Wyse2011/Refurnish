<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!-- Dalamud.NET.Sdk sets the target framework and references Dalamud, ImGui, Lumina and
       FFXIVClientStructs. Same setup as Inkwell. -->
  <PropertyGroup>
    <Version>0.4.4.0</Version>
    <Description>Plan housing layout swaps from MakePlace files: what to store, what to pull, and from where.</Description>
    <PackageProjectUrl>https://github.com/Wyse2011/Refurnish</PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
